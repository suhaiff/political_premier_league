cat >> .gitignore <<'EOF'

# Local archives and backups
*.zip
*.backup

# Environment files
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
.pytest_cache/

# Build output
.next/
node_modules/
EOF
# Local archives and backups
*.zip
*.backup

# Environment files
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
.pytest_cache/

# Build output
.next/
node_modules/
